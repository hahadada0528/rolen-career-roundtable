# AGICTO API 配置（在 https://docs.agicto.com 控制台获取 API Key）
AGICTO_API_KEY=your_api_key_here
AGICTO_BASE_URL=https://api.agicto.cn/v1/

# 文本推理模型（省 token 建议 gpt-4o-mini；专家席共用）
AGICTO_CHAT_MODEL=gpt-4o-mini

# 主 agent 专用模型（留空则与 AGICTO_CHAT_MODEL 相同；建议 gpt-4o 以提升对话理解与表达）
AGICTO_ORCHESTRATOR_MODEL=gpt-4o

# 圆桌最多轮数（省 token 建议 18）
ANALYSIS_MAX_TURNS=18

# 省 token 模式（1=开：禁止 harvest、浏览器每轮最多 5 次读页）
ROUNDTABLE_ECONOMY=1
ROUNDTABLE_BROWSER_READS=5

# 本机 Chrome 远程调试端口（先运行「启动Chrome供圆桌.bat」）
ROUNDTABLE_CDP_PORT=9222

# 本地 AI 工具知识库模板（Obsidian / LLM Wiki 技能来源）。每个职业会另建「{职业名}知识库」
AI_DATABASE_PATH=C:\Users\joe_c\OneDrive\Desktop\AI数据库

# ---------- TencentDB Agent Memory（可选，默认关）----------
# 需本机先启动 Memory Core Gateway（默认 :8420），见 docs/TENCENT_MEMORY.md
# TENCENT_MEMORY_ENABLED=0
# TENCENT_MEMORY_GATEWAY_URL=http://127.0.0.1:8420
# TENCENT_MEMORY_API_KEY=
# 若部署了 Memory Proxy，可把 LLM 请求改走 Proxy（注入团队记忆）；留空则仍走 AGICTO
# TENCENT_MEMORY_PROXY_URL=
# TENCENT_MEMORY_SESSION_PREFIX=roundtable

# 职业历史数据根目录（默认：程序目录/data；每职业一文件夹，含记忆/背调/调研/tools/上传/知识库）
# ROUNDTABLE_DATA_ROOT=D:\my-roundtable-data
# CAREER_DESKTOP=C:\Users\你\Desktop
